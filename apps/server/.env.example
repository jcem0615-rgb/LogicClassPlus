# ---------------------------------------------------------------
# LogicClass+ server environment
# Copy to .env and fill in real values.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=4001

# Comma-separated list of origins allowed to call the API and open sockets.
WEB_ORIGIN=http://localhost:4000,http://127.0.0.1:4000

# --- database -----------------------------------------------------
DATABASE_URL=postgresql://logicclass:logicclass@127.0.0.1:5432/logicclass?schema=public

# --- auth ---------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seeded Owner/Admin. The Owner is never self-registered.
SEED_OWNER_EMAIL=owner@logicclass.plus
SEED_OWNER_PASSWORD=admin1234
SEED_OWNER_NAME=Marisol Vega
# Set to false in production to seed only the Owner, with no demo data.
SEED_DEMO_DATA=true

# --- payroll policy ----------------------------------------------
PAYROLL_GRACE_MINUTES=5
PAYROLL_LATE_PENALTY=1.5
PAYROLL_CURRENCY=USD

# --- uploads ------------------------------------------------------
UPLOAD_MAX_BYTES=20971520
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Uploads fall back to local disk when S3 is not configured.
LOCAL_UPLOAD_DIR=./var/uploads

# --- Stripe -------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Web Push (VAPID) --------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@logicclass.plus

# --- WebRTC ------------------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN is required for participants behind symmetric NAT. With coturn's
# use-auth-secret mode set TURN_STATIC_SECRET and the server mints
# short-lived credentials per request; otherwise set a static user/password.
TURN_URLS=
TURN_STATIC_SECRET=
TURN_USERNAME=
TURN_PASSWORD=
TURN_TTL_SECONDS=21600

# --- recording ----------------------------------------------------
# none | livekit. P2P WebRTC cannot be recorded server-side; recording
# needs an SFU. LiveKit Egress uploads the file straight to S3_BUCKET.
RECORDING_PROVIDER=none
# audio | 360p | 480p | 720p | 1080p — drives both the encoder and the
# size estimate shown in the app. A 3-hour class at 720p is about 2.15 GB.
RECORDING_PRESET=720p
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Sign-in attempts per IP per 15 minutes. Defaults to 30 in production and
# 500 in development. Lower it if you are under credential-stuffing pressure.
AUTH_RATE_LIMIT=
