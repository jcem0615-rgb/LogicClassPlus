// ---------------------------------------------------------------
// LogicClass+ — data model
// Money is stored in minor units (cents) as integers. Never floats.
// ---------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum Subject {
  MATH
  ENGLISH
}

enum Audience {
  ALL
  TEACHERS
  STUDENTS
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum SessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum DocumentKind {
  BOARD
  DOCUMENT
  EQUATION
  ANNOTATION
}

enum BatchStatus {
  DRAFT
  APPROVED
  PAID
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

enum ResetStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  name            String
  role            Role       @default(STUDENT)
  status          UserStatus @default(PENDING)
  locale          String     @default("en-US") // reserved for i18n; no framework wired yet
  timezone        String     @default("UTC")
  subjects        Subject[]  @default([])
  hourlyRateCents Int? // teachers only
  gradeLevel      String? // students only
  bio             String?
  seeded          Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  folders           Folder[]
  resources         Resource[]
  announcements     Announcement[]
  requestsAsStudent ClassRequest[]         @relation("StudentRequests")
  requestsAsTeacher ClassRequest[]         @relation("TeacherRequests")
  seats             SessionParticipant[]   @relation("SessionSeats")
  sessionsAsTeacher ClassSession[]         @relation("TeacherSessions")
  attendance        Attendance[]
  payrollLines      PayrollLine[]
  approvedBatches   PayrollBatch[]         @relation("BatchApprover")
  invoices          Invoice[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  resetRequests     PasswordResetRequest[] @relation("ResetSubject")
  resolvedResets    PasswordResetRequest[] @relation("ResetResolver")
  chatMessages      ChatMessage[]
  attempts          PronunciationAttempt[] @relation("StudentAttempts")
  invitesSent       Invitation[]           @relation("InvitesSent")
  invitedBy         Invitation?            @relation("InviteAccepted")
  children          Guardian[]             @relation("GuardianParent")
  guardians         Guardian[]             @relation("GuardianStudent")

  @@index([role, status])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Who may see a student's classes and invoices besides the student.
/// Links are made by the Owner from the admin portal, never self-claimed:
/// a child's timetable is not something to hand out on an email match.
model Guardian {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())

  parent  User @relation("GuardianParent", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("GuardianStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

model Folder {
  id        String   @id @default(cuid())
  teacherId String
  parentId  String?
  name      String
  subject   Subject
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher   User       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  parent    Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderTree")
  resources Resource[]

  @@index([teacherId])
}

model Resource {
  id         String   @id @default(cuid())
  folderId   String
  teacherId  String // denormalised so every query can filter by owner without a join
  name       String
  ext        String
  mimeType   String?
  bytes      Int
  storageKey String
  createdAt  DateTime @default(now())

  folder  Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  teacher User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([teacherId])
}

model Announcement {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  body      String
  audience  Audience @default(ALL)
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model ClassRequest {
  id           String        @id @default(cuid())
  studentId    String
  teacherId    String
  subject      Subject
  topic        String
  note         String?
  requestedFor DateTime
  minutes      Int           @default(60)
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  student User          @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  teacher User          @relation("TeacherRequests", fields: [teacherId], references: [id], onDelete: Cascade)
  session ClassSession?

  @@index([teacherId, status])
  @@index([studentId, status])
}

/// A class, private or group. `capacity` is how many students may sit in it:
/// 1 is the ordinary one-to-one lesson, more than 1 is a group class students
/// book themselves into. Who is in it lives in SessionParticipant and nowhere
/// else — a `studentId` column here would be a second answer to the same
/// question, and the two would drift.
model ClassSession {
  id                String        @id @default(cuid())
  requestId         String?       @unique
  teacherId         String
  capacity          Int           @default(1)
  /// What one seat costs, for a group class the students book themselves.
  /// Null on a private lesson, which the Owner invoices from the hourly rate.
  seatPriceCents    Int?
  subject           Subject
  topic             String
  startsAt          DateTime
  minutes           Int           @default(60)
  status            SessionStatus @default(SCHEDULED)
  joinedAt          DateTime?
  endedAt           DateTime?
  // Recording is produced by the media server, not the browsers. P2P WebRTC
  // gives the server no stream, so these stay null until an SFU fills them.
  recordingUrl      String?
  recordingEgressId String?
  /// When the running egress was started, so a recording nobody stopped can
  /// be cut off at the cap instead of billing storage until someone notices.
  recordingStartedAt DateTime?
  recordingBytes    BigInt?
  recordingSeconds  Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  request      ClassRequest?          @relation(fields: [requestId], references: [id], onDelete: SetNull)
  teacher      User                   @relation("TeacherSessions", fields: [teacherId], references: [id], onDelete: Cascade)
  participants SessionParticipant[]
  attendance   Attendance?
  documents    SessionDocument[]
  messages     ChatMessage[]
  attempts     PronunciationAttempt[]

  @@index([teacherId, startsAt])
  @@index([startsAt])
}

/// One student's seat in a class. The row existing is the booking; `joinedAt`
/// is stamped the first time they actually enter the room, which is how a
/// group class tells who turned up from who merely booked.
model SessionParticipant {
  id        String    @id @default(cuid())
  sessionId String
  studentId String
  bookedAt  DateTime  @default(now())
  joinedAt  DateTime?

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User         @relation("SessionSeats", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model SessionDocument {
  id        String       @id @default(cuid())
  sessionId String
  kind      DocumentKind
  content   String // whiteboard stroke JSON, Tiptap HTML, or LaTeX source
  updatedBy String?
  updatedAt DateTime     @updatedAt
  createdAt DateTime     @default(now())

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, kind])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model Attendance {
  id             String    @id @default(cuid())
  teacherId      String
  sessionId      String    @unique
  scheduledStart DateTime
  clockIn        DateTime?
  clockOut       DateTime?
  minutesLate    Int       @default(0)
  noShow         Boolean   @default(false)
  deductionCents Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  teacher User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([teacherId, scheduledStart])
}

model PayrollBatch {
  id           String      @id @default(cuid())
  periodStart  DateTime
  periodEnd    DateTime
  status       BatchStatus @default(DRAFT)
  approvedById String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  approvedBy User?         @relation("BatchApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  lines      PayrollLine[]
}

model PayrollLine {
  id             String @id @default(cuid())
  batchId        String
  teacherId      String
  sessions       Int    @default(0)
  minutes        Int    @default(0)
  lateMinutes    Int    @default(0)
  noShows        Int    @default(0)
  grossCents     Int    @default(0)
  deductionCents Int    @default(0)
  netCents       Int    @default(0)

  batch   PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([batchId, teacherId])
}

model Invoice {
  id                    String        @id @default(cuid())
  number                String        @unique
  studentId             String
  amountCents           Int
  currency              String        @default("USD")
  status                InvoiceStatus @default(DRAFT)
  issuedAt              DateTime      @default(now())
  dueAt                 DateTime
  paidAt                DateTime?
  stripeInvoiceId       String?
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  student User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lines   InvoiceLine[]

  @@index([studentId, status])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  label       String
  amountCents Int
  /// The class this line charges for, when it charges for one. Billing a
  /// group class twice has to be recognised by the class, not by the words
  /// on the line: two classes can share a title.
  sessionId   String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// One recorded attempt at a pronunciation drill, scored by the speech
/// provider. Kept so a student can see progress and a teacher can compare
/// today's attempt with last week's.
model PronunciationAttempt {
  id                 String   @id @default(cuid())
  studentId          String
  sessionId          String?
  referenceText      String
  language           String   @default("en-US")
  recognizedText     String?
  accuracyScore      Float?
  fluencyScore       Float?
  completenessScore  Float?
  pronunciationScore Float?
  prosodyScore       Float?
  durationSeconds    Float?
  /// Per-word and per-phoneme detail, exactly as mapped from the provider.
  words              Json?
  provider           String   @default("azure")
  createdAt          DateTime @default(now())

  student User          @relation("StudentAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  session ClassSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([sessionId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  url       String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// An invitation to join. Registration is by invitation only: the Owner
/// decides who gets an account, so there is no open form for anyone on the
/// internet to fill in.
///
/// Only the hash of the token is stored. The link is shown once, when it is
/// created, and a copy of the database does not hand out accounts.
model Invitation {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  /// Optional: when set, only this address may accept it.
  email           String?
  role            Role
  subjects        Subject[] @default([])
  /// A teacher's rate, agreed before they join rather than after.
  hourlyRateCents Int?
  gradeLevel      String?
  note            String?
  createdById     String
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedById    String?   @unique
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  createdBy  User  @relation("InvitesSent", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("InviteAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([role, acceptedAt])
}

model PasswordResetRequest {
  id             String      @id @default(cuid())
  userId         String
  email          String
  status         ResetStatus @default(PENDING)
  tokenHash      String?
  tokenExpiresAt DateTime?
  requestedAt    DateTime    @default(now())
  resolvedAt     DateTime?
  resolvedById   String?

  user       User  @relation("ResetSubject", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ResetResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
}
